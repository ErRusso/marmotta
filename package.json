{
  "name": "marmotta",
  "version": "0.8.0",
  "description": "Marmotta - a Node.js native addon build tool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/napi-bindings/marmotta.git"
  },
  "author": {
    "name": "Nicola Del Gobbo",
    "email": "nicoladelgobbo@gmail.com",
    "url": "https://github.com/NickNaso"
  },
  "contributors": [
    {
      "name": "Simone Russo",
      "email": "s.russo06@icloud.com",
      "url": "https://github.com/ErRusso"
    }
  ],
  "keywords": [
    "native",
    "addon",
    "module",
    "c",
    "c++",
    "bindings",
    "zig",
    "bindings",
    "build",
    "buildtools",
    "n-api",
    "napi",
    "node-api",
    "node-addon-api"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "marmotta": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/node-api-headers.tar",
    "README.md",
    "LICENSE",
    "marmotta.jpg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "check:version": "node scripts/check-version.mjs",
    "test": "npm run check:version && npm run build && node --test",
    "build:headers": "node scripts/build-headers-asset.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "build:bun": "node scripts/build-bun.mjs",
    "smoke": "node scripts/smoke.mjs",
    "packages": "node scripts/packages.mjs",
    "packages:build": "node scripts/packages.mjs --build",
    "publish:all": "node scripts/publish.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-api-headers": "^1.3.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  }
}
